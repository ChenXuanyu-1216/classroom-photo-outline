# Copy to <your-private-data-directory>/.env.reviewer and enter your own key.
# The reviewer entry point always uses the official DeepSeek API; no mock fallback.
APP_MODEL_PROVIDER=deepseek
APP_CLUSTER_PROVIDER=model
APP_MODEL_BASE_URL=https://api.deepseek.com
APP_MODEL_NAME=deepseek-flash
APP_MODEL_API_KEY=
APP_KNOWLEDGE_EXPANSION_ENABLED=true
APP_MODEL_BUDGET_ENFORCED=true
APP_MODEL_BUDGET_CNY=5
