# LAN for local phone testing; use 127.0.0.1 behind a same-machine HTTPS proxy.
APP_SERVER_HOST=0.0.0.0
APP_MODEL_PROVIDER=mock
# WeChat server-side login only. Never put AppSecret in miniprogram files.
APP_WECHAT_APP_ID=
APP_WECHAT_APP_SECRET=
APP_WECHAT_TRUST_ENV=false
# release in production; develop/trial before public release.
APP_WECHAT_QRCODE_ENV=release
APP_AUTH_SESSION_TTL_SECONDS=604800
APP_CLUSTER_PROVIDER=rule
APP_KNOWLEDGE_EXPANSION_ENABLED=true
APP_MODEL_API_KEY=
APP_MODEL_BASE_URL=https://api.deepseek.com
APP_MODEL_NAME=deepseek-flash
APP_MODEL_TIMEOUT_SECONDS=60
# Direct model connection; true explicitly opts into OS/environment proxy settings.
APP_MODEL_TRUST_ENV=false
APP_MODEL_MAX_RETRY=1
# Single-machine durable queue for browser requests. No Redis/Celery required.
APP_TASK_QUEUE_ENABLED=true
APP_TASK_QUEUE_CAPACITY=20
APP_MODEL_MAX_TOKENS=4096
APP_DIAGRAM_REVIEW_MAX_TOKENS=16384
# Optional local cap; accounting continues when false.
APP_MODEL_BUDGET_ENFORCED=false
APP_MODEL_BUDGET_CNY=5
APP_MODEL_CONTEXT_MAX_BYTES=96000
APP_IMAGE_MAX_EDGE=2560
APP_IMAGE_MAX_PIXELS=24000000
APP_ALLOWED_EXT=.jpg,.jpeg,.png,.pdf
APP_MAX_FILE_MB=10
APP_MAX_FILES_PER_BATCH=20
APP_RECOMMENDED_BATCH=10
APP_LOW_CONFIDENCE_THRESHOLD=0.60
