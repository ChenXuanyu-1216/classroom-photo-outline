# PLACEHOLDERS ONLY. Configure secrets in the cloud runtime, never in an image.
APP_DEPLOYMENT_MODE=cloud
APP_DATABASE_URL=mysql+pymysql://APP_USER:ENCODED_PASSWORD@MYSQL_HOST/APP_DATABASE
APP_DATABASE_TLS_CA=
APP_STORAGE_BACKEND=cos
APP_COS_BUCKET=PRIVATE_BUCKET
APP_COS_REGION=ap-shanghai
# WeChat Cloud Hosting: authorize /_/cos/getauth; keep static/file credentials empty.
APP_COS_CREDENTIALS_SOURCE=wechat-cloudrun
APP_COS_SECRET_ID=
APP_COS_SECRET_KEY=
APP_COS_SESSION_TOKEN=
APP_COS_CREDENTIALS_FILE=
APP_TASK_WORKER_MODE=external
APP_CLOUD_EXECUTION_VERIFIED=false
APP_MODEL_PROVIDER=mock
APP_CLOUD_ALLOW_MOCK=true
APP_MODEL_API_KEY=
APP_MODEL_BUDGET_ENFORCED=true
APP_MODEL_BUDGET_CNY=5.00
APP_WECHAT_APP_ID=YOUR_APPID
APP_WECHAT_APP_SECRET=
APP_WECHAT_QRCODE_ENV=trial
APP_PUBLIC_WEB_ENABLED=false
APP_PUBLIC_ORIGIN=
APP_CLOUD_MAX_ACTIVE_JOBS_USER=3
PORT=8000
