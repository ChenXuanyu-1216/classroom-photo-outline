:host { display: block; }
.studio-header { color: #283e33; }
.brand-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0 22rpx; }
.brand { display: flex; align-items: center; gap: 16rpx; font: 600 39rpx 'Songti SC', 'SimSun', serif; letter-spacing: 3rpx; }
.paper-icon { position: relative; width: 32rpx; height: 38rpx; }
.paper-icon view { position: absolute; width: 22rpx; height: 29rpx; border: 2rpx solid #526650; border-radius: 3rpx; left: 1rpx; top: 6rpx; }
.paper-icon view + view { left: 9rpx; top: 0; background: #f5f1e8; }
.speed { margin: 0; padding: 0 8rpx; width: auto; font: 22rpx/2.3 sans-serif; color: #7e8774; background: transparent; }
.speed::after { border: 0; }
.tabs { display: flex; border-bottom: 1rpx solid #dfdfd0; }
.tab { flex: 1; padding: 20rpx 0 22rpx; text-align: center; font-size: 25rpx; letter-spacing: 3rpx; color: #88907e; border: 1rpx solid transparent; border-bottom: 0; }
.current { position: relative; background: #fffefa; border-color: #dedbcf; border-radius: 10rpx 10rpx 0 0; color: #24483e; }
.current::after { content: ''; position: absolute; bottom: 13rpx; left: 37%; right: 37%; height: 1rpx; background: #24483e; }
.hero { padding-top: 40rpx; }
.hero-title { font: 500 45rpx/1.65 'Songti SC', 'SimSun', serif; letter-spacing: -1rpx; }
.hero-subtitle { color: #7e8774; font: 22rpx/1.9 sans-serif; margin-top: 10rpx; }
.scene { position: relative; height: 300rpx; margin: 8rpx 0 12rpx; overflow: hidden; }
.knowledge-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.source-photo, .excerpt, .annotation { z-index: 1; }
.source-photo { position: absolute; top: 36%; left: 3%; width: 120rpx; padding: 8rpx; background: #fffdf5; border: 1rpx solid #e1decf; transform: rotate(-7deg); box-shadow: 0 8rpx 15rpx #4f4b2b12; animation: photo-drift 12s ease-in-out infinite alternate; }
.source-photo image { display: block; height: 68rpx; width: 100%; }
.source-photo text { display: block; font-size: 15rpx; color: #8a947d; margin-top: 7rpx; }
.excerpt { position: absolute; top: 26%; left: 31%; padding: 12rpx 17rpx; background: #fffdf5; color: #52684b; border-bottom: 1rpx solid #9aab86; font: 22rpx/1.6 'Songti SC', 'SimSun', serif; box-shadow: 0 5rpx 15rpx #544f3210; animation: excerpt-drift 12s ease-in-out infinite alternate; }
.excerpt text { display: block; color: #9aab86; font-size: 15rpx; letter-spacing: 3rpx; }
.annotation { position: absolute; right: 12rpx; bottom: 4rpx; font: 21rpx 'KaiTi','Songti SC',serif; color: #8c9675; transform: rotate(-3deg); letter-spacing: 1rpx; }
@keyframes photo-drift { from { transform: translateY(3rpx) rotate(-7deg); } to { transform: translateY(-8rpx) rotate(-4deg); } }
@keyframes excerpt-drift { from { transform: translateY(-2rpx) rotate(2deg); } to { transform: translateY(7rpx) rotate(0); } }
@media (prefers-reduced-motion: reduce) { .source-photo, .excerpt { animation: none; } }
